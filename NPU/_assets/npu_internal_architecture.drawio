        <mxCell id="v7" value="&lt;b&gt;DMA / Layout Engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;连续搬运与类型转换&lt;br&gt;L1 本地复制独立写口&lt;br&gt;Ethernet 旁带 RX&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#17324D;align=center;fontStyle=1;verticalAlign=middle;spacing=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="490" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="&lt;b&gt;Matrix / Vector 包装&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Direct / Scalar / Vector MUL-FMA&lt;br&gt;共享四个物理 PE，每 PE 八个 4×8 乘法叶&lt;br&gt;Vector 轻量 ALU 独立，乘法需仲裁&lt;br&gt;16 个逻辑 lane 按模式分 phase 执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#17324D;align=center;fontStyle=1;verticalAlign=middle;spacing=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="500" height="320" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="&lt;b&gt;Complex Engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;可裁剪 stream / legacy 路径&lt;br&gt;两个逻辑 FMA 请求入口经仲裁&lt;br&gt;共享一个物理 mixed-FMA word 流水&lt;br&gt;普通 L1 与独立写回端口&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#17324D;align=center;fontStyle=1;verticalAlign=middle;spacing=8;arcSize=12;" vertex="1" parent="1">
