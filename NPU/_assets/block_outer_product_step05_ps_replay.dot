digraph OuterProductStep {
  graph [
    charset="UTF-8",
    bgcolor="white",
    rankdir=TB,
    newrank=true,
    splines=ortho,
    nodesep=0.38,
    ranksep=0.52,
    pad=0.20,
    size="9.2,7.4!",
    ratio=compress,
    fontname="Microsoft YaHei",
    fontsize=21,
    labelloc=t,
    label="步骤 5\n进入 p=1，旧部分和回放到阵列"
  ];
  node [shape=plain, fontname="Microsoft YaHei", fontsize=16];
  edge [fontname="Microsoft YaHei", fontsize=12, penwidth=2.4, arrowsize=0.72];

  a [group="left", label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#3478C5"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="4" BGCOLOR="#F8FAFC"><B>A 输入块（系统内存）</B></TD></TR><TR><TD BORDER="0" WIDTH="58"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#DCEFFF"><B>A00</B><BR/><FONT POINT-SIZE="11">完成</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#75B8F0"><B>A01</B><BR/><FONT POINT-SIZE="11">使用中</FONT></TD><TD BORDER="0" WIDTH="58"></TD></TR><TR><TD BORDER="0" WIDTH="58"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#DCEFFF"><B>A10</B><BR/><FONT POINT-SIZE="11">完成</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#75B8F0"><B>A11</B><BR/><FONT POINT-SIZE="11">使用中</FONT></TD><TD BORDER="0" WIDTH="58"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="4"><FONT POINT-SIZE="11">p=1 输入组；当前使用 1/3 次</FONT></TD></TR></TABLE>>];
  bias [group="center", label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#7A68B3"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="5" BGCOLOR="#F8FAFC"><B>bias 子向量</B></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>b0</B><BR/><FONT POINT-SIZE="11">关闭</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>b1</B><BR/><FONT POINT-SIZE="11">关闭</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>b2</B><BR/><FONT POINT-SIZE="11">关闭</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="5"><FONT POINT-SIZE="11">bias 已在 p=0 使用，不再加入</FONT></TD></TR></TABLE>>];
  b [group="right", label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#D98C10"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="5" BGCOLOR="#F8FAFC"><B>B 权重块（系统内存）</B></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#FFF0C9"><B>B00</B><BR/><FONT POINT-SIZE="11">完成</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#FFF0C9"><B>B01</B><BR/><FONT POINT-SIZE="11">完成</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#FFF0C9"><B>B02</B><BR/><FONT POINT-SIZE="11">完成</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>B10</B><BR/><FONT POINT-SIZE="11">驻留</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#FFF0C9"><B>B11</B><BR/><FONT POINT-SIZE="11">已就绪</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#FFF0C9"><B>B12</B><BR/><FONT POINT-SIZE="11">等待</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="5"><FONT POINT-SIZE="11">B10 在 PE；B11 位于备用槽</FONT></TD></TR></TABLE>>];
  ia [group="left", label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#3478C5"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="4" BGCOLOR="#F8FAFC"><B>IA 缓存槽</B></TD></TR><TR><TD BORDER="0" WIDTH="58"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#DCEFFF"><B>S0</B><BR/><FONT POINT-SIZE="11">可复用</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#DCEFFF"><B>S1</B><BR/><FONT POINT-SIZE="11">可复用</FONT></TD><TD BORDER="0" WIDTH="58"></TD></TR><TR><TD BORDER="0" WIDTH="58"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#75B8F0"><B>S2</B><BR/><FONT POINT-SIZE="11">A01→</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#75B8F0"><B>S3</B><BR/><FONT POINT-SIZE="11">A11→</FONT></TD><TD BORDER="0" WIDTH="58"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="4"><FONT POINT-SIZE="11">S2、S3 连续输出 p=1 输入</FONT></TD></TR></TABLE>>];
  pe [group="center", label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#25825B"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="5" BGCOLOR="#F8FAFC"><B>PE 权重阵列（2×3 示意）</B></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>w</B><BR/><FONT POINT-SIZE="11">B10</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>w</B><BR/><FONT POINT-SIZE="11">B10</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>w</B><BR/><FONT POINT-SIZE="11">B10</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>w</B><BR/><FONT POINT-SIZE="11">B10</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>w</B><BR/><FONT POINT-SIZE="11">B10</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>w</B><BR/><FONT POINT-SIZE="11">B10</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="5"><FONT POINT-SIZE="11">B10 驻留；旧 PS 与新块乘相加</FONT></TD></TR></TABLE>>];
  wb [group="right", label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#D98C10"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="4" BGCOLOR="#F8FAFC"><B>权重双槽缓冲</B></TD></TR><TR><TD BORDER="0" WIDTH="58"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#F6BD55"><B>W0</B><BR/><FONT POINT-SIZE="11">B10→</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#FFF0C9"><B>W1</B><BR/><FONT POINT-SIZE="11">B11</FONT></TD><TD BORDER="0" WIDTH="58"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="4"><FONT POINT-SIZE="11">B10 写 PE；B11 保持就绪</FONT></TD></TR></TABLE>>];
  ps [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#7A68B3"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="5" BGCOLOR="#F8FAFC"><B>PS 输出块网格</B></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#73D09C"><B>C00</B><BR/><FONT POINT-SIZE="11">最终</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#B7A2E5"><B>C01</B><BR/><FONT POINT-SIZE="11">p0</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#B7A2E5"><B>C02</B><BR/><FONT POINT-SIZE="11">p0</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#73D09C"><B>C10</B><BR/><FONT POINT-SIZE="11">最终</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#B7A2E5"><B>C11</B><BR/><FONT POINT-SIZE="11">p0</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#B7A2E5"><B>C12</B><BR/><FONT POINT-SIZE="11">p0</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="5"><FONT POINT-SIZE="11">frame 0 回放后更新；frame 1/2 等待</FONT></TD></TR></TABLE>>];
  post [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#299153"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="5" BGCOLOR="#F8FAFC"><B>输出处理</B></TD></TR><TR><TD BORDER="0" WIDTH="3"></TD><TD BORDER="1" WIDTH="82" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>int32</B></TD><TD BORDER="1" WIDTH="82" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>整数缩放</B></TD><TD BORDER="1" WIDTH="82" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>激活/打包</B></TD><TD BORDER="0" WIDTH="3"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="5"><FONT POINT-SIZE="11">仍有 B11、B12，不处理</FONT></TD></TR></TABLE>>];
  c [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#25825B"><TR><TD BORDER="1" WIDTH="252" HEIGHT="34" FIXEDSIZE="TRUE" COLSPAN="5" BGCOLOR="#F8FAFC"><B>C 输出块（系统内存）</B></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>C00</B><BR/><FONT POINT-SIZE="11">空</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>C01</B><BR/><FONT POINT-SIZE="11">空</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>C02</B><BR/><FONT POINT-SIZE="11">空</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="0" WIDTH="24"></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>C10</B><BR/><FONT POINT-SIZE="11">空</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>C11</B><BR/><FONT POINT-SIZE="11">空</FONT></TD><TD BORDER="1" WIDTH="68" HEIGHT="68" FIXEDSIZE="TRUE" BGCOLOR="#EDF0F4"><B>C12</B><BR/><FONT POINT-SIZE="11">空</FONT></TD><TD BORDER="0" WIDTH="24"></TD></TR><TR><TD BORDER="1" WIDTH="252" HEIGHT="38" FIXEDSIZE="TRUE" COLSPAN="5"><FONT POINT-SIZE="11">输出区尚未写入</FONT></TD></TR></TABLE>>];

  { rank=same; a; bias; b; }
  { rank=same; ia; pe; wb; }
  { rank=same; ps; post; c; }
  a -> bias [style=invis, weight=100];
  bias -> b [style=invis, weight=100];
  ia -> pe [style=invis, weight=100];
  pe -> wb [style=invis, weight=100];

  a -> ia [color="#3478C5", fontcolor="#3478C5", style="solid", xlabel="A01、A11", dir="forward"];
  b -> wb [color="#D98C10", fontcolor="#D98C10", style="solid", xlabel="预读 B11", dir="forward"];
  bias -> pe [color="#AAB2BF", fontcolor="#AAB2BF", style="dashed", xlabel="bias 关闭", dir="forward"];
  ia -> pe [color="#3478C5", fontcolor="#3478C5", style="solid", xlabel="p=1 IA 流", dir="forward"];
  wb -> pe [color="#D98C10", fontcolor="#D98C10", style="solid", xlabel="B10", dir="forward"];
  pe -> ps [color="#7A68B3", fontcolor="#7A68B3", style="solid", xlabel="旧值↑ 新值↓", dir="both"];
  ps -> post [color="#AAB2BF", fontcolor="#AAB2BF", style="dashed", xlabel="等待", dir="forward"];
  post -> c [color="#AAB2BF", fontcolor="#AAB2BF", style="dashed", xlabel="AXI 写", dir="forward"];

  legend [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#7A8494">
        <TR>
          <TD BGCOLOR="#75B8F0">IA / A</TD>
          <TD BGCOLOR="#F6BD55">权重 / B</TD>
          <TD BGCOLOR="#C5B0EB">bias / PS</TD>
          <TD BGCOLOR="#73D09C">最终结果 / 写回</TD>
          <TD BGCOLOR="#EDF0F4">等待 / 空闲</TD>
        </TR>
        <TR><TD COLSPAN="5"><FONT POINT-SIZE="10">同类深色：本步使用；同类浅色：已就绪、已保存或已完成</FONT></TD></TR>
      </TABLE>
    >
  ];
  post -> legend [style=invis, weight=20];
}
