digraph NPU_TASK_SCHEDULER_SUBMODULES {
  graph [rankdir=LR, bgcolor="#FFFFFF", pad="0.22", nodesep="0.44", ranksep="0.78", splines=polyline, outputorder=nodesfirst, fontname="Noto Sans CJK SC", fontsize=20, fontcolor="#123B5D", labelloc=t, label="TaskScheduler 子模块连接"];
  node [shape=box, style="rounded,filled", margin="0.18,0.12", fontname="Noto Sans CJK SC", fontsize=13, color="#64748B", penwidth=1.3, fillcolor="#F8FAFC", fontcolor="#17324D"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#2563EB", fontcolor="#334155", penwidth=1.35, arrowsize=0.70];
  CFE [label="CFE\n128-bit CMD", fillcolor="#E0F2FE", color="#0284C7"];
  subgraph cluster_ts {
    label="TaskScheduler（顶层配置：8 任务槽、255 Event）"; fontname="Noto Sans CJK SC"; fontsize=16; color="#93C5FD"; fillcolor="#EFF6FF"; style="rounded,filled"; penwidth=1.4;
    ADMIT [label="命令接纳寄存级\n基地址快照 / 静态检查"];
    EVENT [label="Event Table\n状态 / 4-bit 代次"];
    TASK [label="Task Table\n任务状态 / 前序位图"];
    WAIT [label="WAIT_EVENT 逐槽检查器"];
    SCAN [label="READY 逐槽扫描器\n最早 submit_seq"];
    SNAP [label="发射窄快照"];
    DECODE [label="共享内联解码器\n2048-bit Task Context"];
    STAGE [label="四组发射暂存\nDMA / Matrix / Vector / CME"];
    DONE [label="完成接收 / Event 发布\n完成持有槽"];
    CTL [label="Control / WAIT / QUERY / FENCE"];
    ADMIT -> TASK; ADMIT -> EVENT; TASK -> WAIT; EVENT -> WAIT; WAIT -> SCAN; TASK -> SCAN; SCAN -> SNAP; SNAP -> DECODE; DECODE -> STAGE; STAGE -> DONE; DONE -> TASK; DONE -> EVENT; CTL -> TASK; CTL -> EVENT;
  }
  ENG [label="DMA / Matrix / Vector / CME\n任务与完成接口", fillcolor="#FEF3C7", color="#D97706"];
  LSC [label="LSC\n控制请求 / 完成通知", fillcolor="#D1FAE5", color="#059669"];
  CFE -> ADMIT [label="ready / valid"];
  STAGE -> ENG [label="task"];
  ENG -> DONE [label="done"];
  LSC -> CTL [label="控制请求"];
  DONE -> LSC [label="completion"];
}
