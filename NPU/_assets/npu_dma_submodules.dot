digraph NPU_DMA_SUBMODULES {
  graph [rankdir=LR, bgcolor="#FFFFFF", pad="0.20", nodesep="0.50", ranksep="0.80", splines=polyline, outputorder=nodesfirst, fontname="Noto Sans CJK SC", fontsize=20, fontcolor="#123B5D", labelloc=t, label="DMA / Layout Engine 子模块连接"];
  node [shape=box, style="rounded,filled", margin="0.18,0.12", fontname="Noto Sans CJK SC", fontsize=14, color="#64748B", penwidth=1.3, fillcolor="#F8FAFC", fontcolor="#17324D"];
  edge [fontname="Noto Sans CJK SC", fontsize=11, color="#2563EB", fontcolor="#334155", penwidth=1.4, arrowsize=0.72];
  TS [label="TaskScheduler\nDMA Task Context", fillcolor="#E0F2FE", color="#0284C7"];
  subgraph cluster_dma {
    label="DMA / Layout Engine"; fontname="Noto Sans CJK SC"; fontsize=16; color="#93C5FD"; fillcolor="#EFF6FF"; style="rounded,filled"; penwidth=1.4;
    CTRL [label="DMA Controller\n任务状态 / 访问次序 / 完成"];
    DP [label="DMA Datapath\n地址游标 / shape 检查\n格式转换 / RMW / progress"];
    FAST [label="整 beat 快速路径\n对齐 COPY 读 burst", fillcolor="#DBEAFE"];
    CTRL -> DP [label="阶段控制"];
    DP -> CTRL [label="地址检查 / 进度"];
    DP -> FAST [label="满足快速条件"];
  }
  L1 [label="L1BUF Controller\n64-bit 请求 / 响应", fillcolor="#F3E8FF", color="#7C3AED"];
  MIF [label="MIF\n全局存储请求 / 响应", fillcolor="#FEF3C7", color="#D97706"];
  TS -> CTRL [label="task"];
  CTRL -> TS [label="done"];
  DP -> L1 [dir=both, label="L1"];
  DP -> MIF [dir=both, label="全局数据"];
  FAST -> MIF [dir=both, label="1～16 beat 读"];
}
