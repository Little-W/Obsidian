digraph NPU_COMPLEX_SUBMODULES {
  graph [rankdir=LR, bgcolor="#FFFFFF", pad="0.20", nodesep="0.50", ranksep="0.80", splines=polyline, outputorder=nodesfirst, fontname="Noto Sans CJK SC", fontsize=20, fontcolor="#123B5D", labelloc=t, label="Complex Math Engine 子模块连接"];
  node [shape=box, style="rounded,filled", margin="0.18,0.12", fontname="Noto Sans CJK SC", fontsize=14, color="#64748B", penwidth=1.3, fillcolor="#F8FAFC", fontcolor="#17324D"];
  edge [fontname="Noto Sans CJK SC", fontsize=11, color="#2563EB", fontcolor="#334155", penwidth=1.4, arrowsize=0.72];
  TS [label="TaskScheduler\nComplex Task Context", fillcolor="#E0F2FE", color="#0284C7"];
  subgraph cluster_cme {
    label="Complex Math Engine"; fontname="Noto Sans CJK SC"; fontsize=16; color="#93C5FD"; fillcolor="#EFF6FF"; style="rounded,filled"; penwidth=1.4;
    CTRL [label="Complex Controller\n行 / 列 / phase 状态"];
    DP [label="Complex Datapath\n整数解包 / FP32 转换\nL1 请求与写回"];
    MSEQ [label="数学序列\nExp / Recip / RecipSqrt\nSigmoid / Tanh / GELU / SiLU", fillcolor="#DBEAFE"];
    ALU [label="FP32 ALU\nADD / SUB / MUL", fillcolor="#DBEAFE"];
    CTRL -> DP [label="阶段控制"];
    DP -> CTRL [label="读写状态 / 结果"];
    DP -> MSEQ; MSEQ -> ALU [dir=both];
  }
  L1 [label="L1BUF Controller\n64-bit 请求 / 响应", fillcolor="#F3E8FF", color="#7C3AED"];
  TS -> CTRL [label="task"];
  CTRL -> TS [label="done"];
  DP -> L1 [dir=both, label="整数张量"];
}
