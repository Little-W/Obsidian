digraph NPU_SINGLE_CORE_PPT {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    bgcolor="#F8FAFC",
    pad="0.24",
    margin="0.04",
    nodesep="0.28",
    ranksep="0.46",
    splines=ortho,
    outputorder=nodesfirst,
    fontname="Microsoft YaHei",
    fontsize=26,
    fontcolor="#123B5D",
    labelloc=t,
    label=<<B>单核 NPU 初版架构：AXI Slave 接收控制 / AXI Master 访问系统内存</B>>
  ];

  node [
    shape=box,
    style="",
    margin="0.16,0.13",
    fontname="Microsoft YaHei",
    fontsize=13,
    fontcolor="#17324D",
    color="#94A3B8",
    fillcolor="#FFFFFF",
    penwidth=1.4
  ];

  edge [
    fontname="Microsoft YaHei",
    fontsize=12,
    fontcolor="#334155",
    color="#2563EB",
    arrowsize=0.74,
    penwidth=1.7
  ];

  subgraph cluster_external {
    label=<<B>主机软件与外部主控 CPU（不属于 NPU）</B>>;
    labelloc=t;
    labeljust=l;
    fontname="Microsoft YaHei";
    fontsize=17;
    fontcolor="#334155";
    color="#CBD5E1";
    fillcolor="#EEF2F7";
    style="rounded,filled";
    penwidth=1.6;
    margin=18;

    compiler [
      shape=plain,
      label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#64748B">
          <TR><TD BGCOLOR="#475569" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>模型编译器</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Keras · PyTorch · TFLite · ONNX</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>图检查 · 算子拆分 · 存储安排 · 调度</B></FONT></TD></TR>
        </TABLE>
      >
    ];

    c_package [
      shape=plain,
      label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#3B82F6">
          <TR><TD BGCOLOR="#2563EB" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>模型专用 C 源码包（.c / .h）</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>配置结构体 · CMD128 指令数组</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Descriptor 数组 · 权重与常量数组</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>输入输出信息 · 操作信息</B></FONT></TD></TR>
          <TR><TD BGCOLOR="#DBEAFE" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>命令分组 · 配置入口</B></FONT></TD></TR>
        </TABLE>
      >
    ];

    runtime [
      shape=plain,
      label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0891B2">
          <TR><TD BGCOLOR="#0891B2" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>模型 Runner / C 驱动</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>读取模型配置 · 准备缓冲区</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>提交 · 等待 · 查询 · ACK · 中断</B></FONT></TD></TR>
        </TABLE>
      >
    ];

    cpu [
      shape=plain,
      label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0F766E">
          <TR><TD BGCOLOR="#0F766E" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>Generic Core / 外部主控 CPU</B></FONT></TD></TR>
          <TR><TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="14"><B>AXI Master</B></FONT></TD></TR>
          <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>执行模型函数并主动发起 64-bit AXI 访问</B></FONT></TD></TR>
        </TABLE>
      >
    ];

    { rank=same; compiler; c_package; }
    { rank=same; runtime; cpu; }

    compiler -> c_package [
      color="#2563EB",
      style=solid
    ];
    c_package -> runtime [
      color="#2563EB",
      style=solid
    ];
    runtime -> cpu [
      color="#0F766E",
      style=solid
    ];
  }

  legend [
    shape=plain,
    group="far_right",
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#94A3B8">
        <TR>
          <TD COLSPAN="2" BGCOLOR="#E2E8F0" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#334155" POINT-SIZE="15"><B>图例</B></FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#EFF6FF" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#2563EB" POINT-SIZE="13"><B>━━▶ 蓝色实线</B></FONT></TD>
          <TD ALIGN="LEFT" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>命令、任务控制与完成消息</B></FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#ECFDF5" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#0F766E" POINT-SIZE="13"><B>━━▶ 青色实线</B></FONT></TD>
          <TD ALIGN="LEFT" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>AXI Slave 寄存器或 L1BUF 窗口访问</B></FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#F5F3FF" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#7C3AED" POINT-SIZE="13"><B>━━▶ 紫色实线</B></FONT></TD>
          <TD ALIGN="LEFT" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>张量数据；双箭头表示读写</B></FONT></TD>
        </TR>
        <TR>
          <TD BGCOLOR="#F8FAFC" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#475569" POINT-SIZE="13"><B>数值格式</B></FONT></TD>
          <TD ALIGN="LEFT" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>INT4 / INT8 / INT16 输入与权重<BR/>INT32 累加 · Complex 局部使用 FP32</B></FONT></TD>
        </TR>
      </TABLE>
    >
  ];

  { rank=same; compiler; c_package; legend; }
  c_package -> legend [style=invis, weight=60];

  axi_bus_in [
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#0F766E">
        <TR>
          <TD BGCOLOR="#0F766E" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>系统 AXI 互连 · 64-bit（同一 SoC Fabric）</B></FONT></TD>
          <TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>CPU 发起访问</B></FONT></TD>
          <TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>NPU 接收访问</B></FONT></TD>
        </TR>
        <TR>
          <TD COLSPAN="3" BGCOLOR="#ECFDF5" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>CMD_FIFO_DATA 0x020000 · AWBURST=FIXED · 2～16 个偶数 beat · 一次 1～8 CMD</B></FONT></TD>
        </TR>
      </TABLE>
    >
  ];

  cpu -> axi_bus_in [
    color="#0F766E",
    penwidth=2.4
  ];

  subgraph cluster_npu {
    label=<<B>NPU 单核硬件</B>>;
    labelloc=t;
    labeljust=l;
    fontname="Microsoft YaHei";
    fontsize=19;
    fontcolor="#1E3A5F";
    color="#2563EB";
    fillcolor="#F8FBFF";
    style="rounded,filled";
    penwidth=2.3;
    margin=18;

    subgraph cluster_command {
      label=<<B>COMMAND &amp; TASK CONTROL</B>>;
      labelloc=t;
      labeljust=l;
      fontname="Microsoft YaHei";
      fontsize=15;
      fontcolor="#1D4ED8";
      color="#93C5FD";
      fillcolor="#EFF6FF";
      style="rounded,filled";
      penwidth=1.5;
      margin=16;

      axi_slave [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0891B2">
            <TR><TD COLSPAN="3" BGCOLOR="#0891B2" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="16"><B>NPU AXI Slave Front End</B></FONT></TD></TR>
            <TR>
              <TD BGCOLOR="#CFFAFE" WIDTH="230" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>CMD FIFO 数据 / 响应 / 状态</B></FONT></TD>
              <TD BGCOLOR="#CCFBF1" WIDTH="230" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>LSC 控制寄存器</B></FONT></TD>
              <TD BGCOLOR="#D1FAE5" WIDTH="230" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>L1BUF 外部访问窗口</B></FONT></TD>
            </TR>
            <TR>
              <TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>0x020000 数据（WO）<BR/>0x020008 响应 FIFO（RO）<BR/>0x020010 状态（RO）</B></FONT></TD>
              <TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>AXI Slave 寄存器请求</B></FONT></TD>
              <TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>AXI Slave 窗口请求</B></FONT></TD>
            </TR>
            <TR>
              <TD PORT="cmd" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>AWBURST=FIXED · 2～16 个偶数 beat<BR/>一次 1～8 CMD · low / high 相邻</B></FONT></TD>
              <TD PORT="csr" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>配置 · 状态 · 中断 · 计数</B></FONT></TD>
              <TD PORT="l1win" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>按地址读写允许访问的片上区域</B></FONT></TD>
            </TR>
          </TABLE>
        >
      ];

      cfe [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#3B82F6">
            <TR><TD BGCOLOR="#2563EB" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>Command Front End</B></FONT></TD></TR>
            <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>2 × 64-bit beat → CMD128</B></FONT></TD></TR>
            <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>次序 · 版本 · opcode · command_id 检查</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DBEAFE" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>内部接收模块，不发起 AXI 事务</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      lsc [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#14B8A6">
            <TR><TD BGCOLOR="#0F766E" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>LSC / CRG / WDT</B></FONT></TD></TR>
            <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>启动 / 停止 · 功能查询 · 错误记录</B></FONT></TD></TR>
            <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>中断 · 性能计数 · 时钟复位 · 超时</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>由 AXI Slave 寄存器端口访问</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      l1_window_channel [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0D9488">
            <TR><TD BGCOLOR="#0F766E" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="13"><B>L1BUF 窗口通道</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>请求 / 响应中继</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      scheduler [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#8B5CF6">
            <TR>
              <TD COLSPAN="2" BGCOLOR="#7C3AED" WIDTH="345" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>Task Scheduler</B></FONT></TD>
              <TD COLSPAN="2" BGCOLOR="#7C3AED" WIDTH="345" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>Event Table</B></FONT></TD>
            </TR>
            <TR>
              <TD COLSPAN="2" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>任务表 · 就绪检查 · 资源冲突检查 · 发射</B></FONT></TD>
              <TD COLSPAN="2" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>wait0 · wait1 · signal · 终态</B></FONT></TD>
            </TR>
            <TR>
              <TD COLSPAN="4" BGCOLOR="#EDE9FE" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>DFU：向 MIF 提交 Descriptor 读取；TBU（Translation Buffer Unit）返回地址转换结果</B></FONT></TD>
            </TR>
            <TR>
              <TD PORT="dma_task" WIDTH="172" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>DMA 任务执行 / 提交</B></FONT></TD>
              <TD PORT="matrix_task" WIDTH="173" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>Matrix 任务执行 / 提交</B></FONT></TD>
              <TD PORT="vector_task" WIDTH="172" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>Vector 任务执行 / 提交</B></FONT></TD>
              <TD PORT="complex_task" WIDTH="173" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>Complex 任务执行 / 提交</B></FONT></TD>
            </TR>
          </TABLE>
        >
      ];

      { rank=same; cfe; lsc; l1_window_channel; }
      cfe -> lsc [style=invis, weight=20];
      lsc -> l1_window_channel [style=invis, weight=20];

      axi_slave:cmd:s -> cfe:n [
        color="#2563EB",
        style=solid
      ];
      axi_slave:csr:s -> lsc:n [
        color="#0F766E",
        style=solid
      ];
      axi_slave:l1win:s -> l1_window_channel:n [
        color="#0F766E",
        style=solid,
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        penwidth=2.0
      ];
      cfe:s -> scheduler:n [
        color="#2563EB",
        style=solid
      ];
      lsc:s -> scheduler:n [
        color="#0F766E",
        style=solid
      ];
    }

    subgraph cluster_execution {
      label=<<B>EXECUTION UNITS</B>>;
      labelloc=t;
      labeljust=l;
      fontname="Microsoft YaHei";
      fontsize=15;
      fontcolor="#6D28D9";
      color="#C4B5FD";
      fillcolor="#FAF7FF";
      style="rounded,filled";
      penwidth=1.5;
      margin=16;

      dma [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#14B8A6">
            <TR><TD COLSPAN="2" BGCOLOR="#0F766E" HEIGHT="34" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="14"><B>DMA Engine</B></FONT></TD></TR>
            <TR><TD COLSPAN="2" HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>线性 · 跨步 · 分块搬运</B></FONT></TD></TR>
            <TR><TD COLSPAN="2" HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>填充 · 转置 · Pack · Split</B></FONT></TD></TR>
            <TR><TD COLSPAN="2" BGCOLOR="#CCFBF1" HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>为 im2col 准备数据</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      dma_data_port [
        shape=box,
        style="filled",
        color="#7C3AED",
        fillcolor="#EDE9FE",
        fontcolor="#4C1D95",
        fontname="Microsoft YaHei",
        fontsize=11,
        margin="0.10,0.07",
        label="DMA 数据端口\nL1 / MIF"
      ];

      matrix [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#F59E0B">
            <TR><TD BGCOLOR="#F59E0B" HEIGHT="34" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#422006" POINT-SIZE="14"><B>Matrix Engine</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FEF3C7" HEIGHT="48" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>MAC_CTX<BR/>分块矩阵乘加</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FEF3C7" HEIGHT="60" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>ACCUM_CTX / Epilogue<BR/>部分和 · INT32 bias / residual<BR/>重缩放 · 裁剪 · 写回</B></FONT></TD></TR>
            <TR><TD HEIGHT="36" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>无原生 CONV 指令</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      vector [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#FB7185">
            <TR><TD BGCOLOR="#E11D48" HEIGHT="34" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="14"><B>Vector Engine</B></FONT></TD></TR>
            <TR><TD HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Add · Mul · Min / Max</B></FONT></TD></TR>
            <TR><TD HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Compare · Select · ReLU</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FFE4E6" HEIGHT="54" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>残差相加 · 门控乘法 · Mask 选择<BR/>不读取 bias；aux0 为 INT8 mask</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      complex [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#A78BFA">
            <TR><TD BGCOLOR="#7C3AED" HEIGHT="34" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="14"><B>Complex Engine</B></FONT></TD></TR>
            <TR><TD HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Softmax · Norm · GELU</B></FONT></TD></TR>
            <TR><TD HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Sigmoid · Tanh · SiLU</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#EDE9FE" HEIGHT="44" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>INT → FP32 → INT</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      { rank=same; dma; matrix; vector; complex; }
      dma -> matrix [style=invis, weight=20];
      matrix -> vector [style=invis, weight=20];
      vector -> complex [style=invis, weight=20];
      dma -> dma_data_port [
        color="#14B8A6",
        dir=none,
        penwidth=1.2,
        weight=30
      ];
    }

    scheduler:dma_task:s -> dma:n [
      color="#2563EB",
      style=solid,
      dir=both,
      arrowhead=normal,
      arrowtail=normal
    ];
    scheduler:matrix_task:s -> matrix:n [
      color="#2563EB",
      style=solid,
      dir=both,
      arrowhead=normal,
      arrowtail=normal
    ];
    scheduler:vector_task:s -> vector:n [
      color="#2563EB",
      style=solid,
      dir=both,
      arrowhead=normal,
      arrowtail=normal
    ];
    scheduler:complex_task:s -> complex:n [
      color="#2563EB",
      style=solid,
      dir=both,
      arrowhead=normal,
      arrowtail=normal
    ];

    subgraph cluster_storage {
      label=<<B>ON-CHIP STORAGE &amp; NPU MEMORY PORT</B>>;
      labelloc=t;
      labeljust=l;
      fontname="Microsoft YaHei";
      fontsize=15;
      fontcolor="#15803D";
      color="#86EFAC";
      fillcolor="#F0FDF4";
      style="rounded,filled";
      penwidth=1.5;
      margin=16;

      l1 [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#16A34A">
            <TR>
              <TD PORT="dma" BGCOLOR="#DCFCE7" WIDTH="138" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>DMA Port</B></FONT></TD>
              <TD PORT="matrix" BGCOLOR="#DCFCE7" WIDTH="138" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Matrix Port</B></FONT></TD>
              <TD PORT="vector" BGCOLOR="#DCFCE7" WIDTH="138" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Vector Port</B></FONT></TD>
              <TD PORT="complex" BGCOLOR="#DCFCE7" WIDTH="138" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Complex Port</B></FONT></TD>
              <TD PORT="external" BGCOLOR="#D1FAE5" WIDTH="138" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>External Window</B></FONT></TD>
            </TR>
            <TR><TD COLSPAN="5" BGCOLOR="#16A34A" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>L1 Buffer：多 Bank 张量存储</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      l1_bridge [
        shape=plain,
        group="far_right",
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0D9488">
            <TR><TD BGCOLOR="#0F766E" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="13"><B>L1BUF 外部访问桥</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>AXI Slave 请求 / 响应</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#D1FAE5" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>L1 External Port 请求 / 响应</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      mif_tbu [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#14B8A6">
            <TR><TD BGCOLOR="#0F766E" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>MIF · 64-bit AXI Master</B></FONT></TD></TR>
            <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>Descriptor / 权重 / 输入读取 · 输出写回</B></FONT></TD></TR>
            <TR><TD VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>m_axi_* · Burst · outstanding · 响应</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>TBU（Translation Buffer Unit）<BR/>GVA → PA / 状态；不发起 AXI</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      mif_dma_port [
        shape=plain,
        label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#7C3AED">
            <TR><TD BGCOLOR="#7C3AED" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="12"><B>MIF DMA Port</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#EDE9FE" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="11"><B>请求 / 数据 / 响应</B></FONT></TD></TR>
          </TABLE>
        >
      ];

      { rank=same; mif_tbu; mif_dma_port; l1; l1_bridge; }
      mif_tbu -> mif_dma_port [style=invis, weight=20];
      mif_dma_port -> l1 [style=invis, weight=20];
      l1 -> l1_bridge [style=invis, weight=20];

      l1:external:e -> l1_bridge:w [
        color="#0F766E",
        style=solid,
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        penwidth=2.0,
        constraint=false
      ];
    }

    dma_data_port:s -> l1:dma:n [
      color="#7C3AED",
      dir=both,
      arrowhead=normal,
      arrowtail=normal,
      penwidth=2.1
    ];
    matrix:s -> l1:matrix:n [
      color="#7C3AED",
      dir=both,
      arrowhead=normal,
      arrowtail=normal,
      penwidth=2.1
    ];
    vector:s -> l1:vector:n [
      color="#7C3AED",
      dir=both,
      arrowhead=normal,
      arrowtail=normal,
      penwidth=2.1
    ];
    complex:s -> l1:complex:n [
      color="#7C3AED",
      dir=both,
      arrowhead=normal,
      arrowtail=normal,
      penwidth=2.1
    ];

    dma_data_port:w -> mif_dma_port:n [
      color="#7C3AED",
      dir=both,
      arrowhead=normal,
      arrowtail=normal,
      penwidth=2.3,
      constraint=false
    ];

    mif_tbu:e -> mif_dma_port:w [
      color="#7C3AED",
      dir=both,
      arrowhead=normal,
      arrowtail=normal,
      penwidth=2.3,
      constraint=false
    ];

    l1_window_channel:s -> l1_bridge:n [
      color="#0F766E",
      style=solid,
      dir=both,
      arrowhead=normal,
      arrowtail=normal,
      penwidth=2.0,
      constraint=false
    ];
  }

  axi_bus_in -> axi_slave [
    color="#0F766E",
    penwidth=2.5
  ];

  // The invisible vertical guide keeps the enlarged legend against the
  // diagram's right side without adding a visible line.
  legend -> l1_bridge [
    style=invis,
    weight=100
  ];

  axi_bus_out [
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#0F766E">
        <TR>
          <TD BGCOLOR="#0F766E" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>系统 AXI Crossbar · 64-bit</B></FONT></TD>
          <TD BGCOLOR="#CCFBF1" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="13"><B>MIF 的 m_axi_* Master 接入</B></FONT></TD>
        </TR>
      </TABLE>
    >
  ];

  system_slaves [
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#64748B">
        <TR><TD COLSPAN="2" BGCOLOR="#475569" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#FFFFFF" POINT-SIZE="15"><B>系统总线从设备（均位于 NPU 外部）</B></FONT></TD></TR>
        <TR>
          <TD BGCOLOR="#E2E8F0" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>DDR Controller → DDR</B></FONT></TD>
          <TD BGCOLOR="#E2E8F0" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>共享存储 / 其他允许访问的 Slave</B></FONT></TD>
        </TR>
        <TR><TD COLSPAN="2" BGCOLOR="#F8FAFC" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" POINT-SIZE="12"><B>DDR 不与 MIF 直接相连；地址选择由系统 AXI 互连完成</B></FONT></TD></TR>
      </TABLE>
    >
  ];

  same_fabric_note [
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0F766E">
        <TR><TD BGCOLOR="#ECFDF5" ALIGN="LEFT" VALIGN="MIDDLE"><FONT FACE="Microsoft YaHei" COLOR="#0F766E" POINT-SIZE="11"><B>图中上下两个总线框是同一个 SoC AXI Fabric 的两处视图，不是两条独立总线</B></FONT></TD></TR>
      </TABLE>
    >
  ];

  mif_tbu -> axi_bus_out [
    color="#7C3AED",
    penwidth=2.5
  ];
  axi_bus_out -> system_slaves [
    color="#7C3AED",
    dir=both,
    arrowhead=normal,
    arrowtail=normal,
    penwidth=2.5
  ];
  { rank=same; system_slaves; same_fabric_note; }
  system_slaves -> same_fabric_note [style=invis, weight=40];

}
