# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# DC Setup File
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
lappend search_path . ../ref/db ./scripts

#for reading and linking
set synthetic_library {dw_foundation.sldb}
set target_library "sc_max.db"
set link_library "* sc_max.db $synthetic_library"

#shortcuts
history keep 300
alias h "history"
set sh_enable_line_editing true

#misc

set cache_write ../dc_dw_cache
set cache_read $cache_write
set alib_library_analysis_path ../dc_dw_cache

define_design_lib DEFAULT -path ./analyzed

suppress_message "VHDL-2285 PSYN-040 PSYN-088"
suppress_message "CMD-041 UID-401 OPT-170"
# The following lines create a cmd and log file in the logs directory
set timestamp [pid].[clock format [clock scan now] -format "%Y-%m-%d_%H-%M"]
set sh_output_log_file "./logs/${synopsys_program_name}.log.$timestamp"
set sh_command_log_file "./logs/${synopsys_program_name}.cmd.$timestamp"

alias s "source -echo -verbose"

# Prevent compile_ultra from ungrouping for the purposes of this lab
set compile_ultra_ungroup_small_hierarchies false

echo "\n\nSettings:"
echo "link_library:      $link_library"
echo "target_library:    $target_library"
echo "search_path:       $search_path\n\n"

echo "\nI am ready...\n\n\n"
