#!/bin/sh
#
###############################################################
#
#
# If you wish to run the GUI test,
# toggle the following variable to a "1":
# 
test_gui=0
#
#
###############################################################

###############################################################
#
# NO CHANGES REQUIRED BELOW THIS LINE
#
#
########################################################################
#
#
echo " "
echo " ******************************************************"
echo " Running the Synopsys Workshop Installation Test Script"
echo " "
echo "       Course Name:    DFT Compiler 1"
echo "       Course Version: 2010.03"
echo "       Last Update:    2010-07-28"
echo " ******************************************************"
echo ""

/bin/rm -rf .Test
mkdir .Test
results=".Test/results"
echo DFT Compiler 1 Installation Test > $results
echo >> $results

LANG=C
LC_ALL=C
export LANG LC_ALL

echo " Running  Test 1 - installation integrity check"
sum=`find lab* ref dc_dw_cache -follow | sort | cksum | awk '{print $1$2}'`
if [ "$sum" = "150157116828378" ]
then
    echo "Test 1a PASSED:   All files are installed "  >> $results
else
    echo "Test 1a FAILED:   There are files missing in the installation " | tee -a $results
    echo "" | tee -a $results
fi
sum=`cat lab*/scripts/* lab*/.solutions/* lab*/mapped/* ref/db/* ref/rtl/*/vhdl/*.vhd ref/tmax/* ref/tools/* | cksum | awk '{print $1$2}'`
if [ "$sum" = "25017230509902791" ]
then
    echo "Test 1b PASSED:   Files are consistent"  >> $results
else
    echo "Test 1b FAILED:   File consistency problems found" | tee -a $results
    echo "" | tee -a $results
fi

cd .Test
results="./results"
tmpout=/tmp/tmpout$$
echo "exit" > exit.cmd

echo " Running  Test 2 - testing executables"
type dc_shell-t 1>$tmpout 2>&1
if [ "`awk '/not found/ {print "NOTHING"}' $tmpout`" = "NOTHING" ]
then
    echo "Test 2a FAILED:   Cannot locate dc_shell-t executable in current search path" | tee -a $results
else
    location=`cat $tmpout`
	# Now execute the tool, and check the version
	echo "     2a  running dc_shell-t ..."
	dc_shell-t -x exit  1>dc.log 2>&1
	ver=`cat dc.log | awk '/2010.03-SP3/ { print }'`
	if [ "$ver" = "" ]
    then
        echo "Test 2a FAILED:   wrong version: dc_shell-t" | tee -a $results
		echo "  Version NEEDED: 2010.03-SP3" >> $results
    elif [ "`awk '/No such file/ {print "NOTHING"}' dc.log`" = "NOTHING" ]
    then
        echo "Test 2a FAILED:   Cannot locate dc_shell-t" | tee -a $results
	else
        echo "Test 2a PASSED:   $location" >> $results
    fi
fi

type tmax 1>$tmpout 2>&1
if [ "`awk '/not found/ {print "NOTHING"}' $tmpout`" = "NOTHING" ]
then
    echo "Test 2b FAILED:   Cannot locate tmax executable in current search path" | tee -a $results
else
    location=`cat $tmpout`
	# Now execute the tool, and check the version
	echo "     2b  running tmax ..."
	tmax -version 1>tx.log 2>&1
	ver=`cat tx.log | awk '/2010.03-SP3/ { print }'`
	if [ "$ver" = "" ]
    then
        echo "Test 2b FAILED:   wrong version: tmax" | tee -a $results
		echo "  Version NEEDED: 2010.03-SP3" >> $results
    elif [ "`awk '/No such file/ {print "NOTHING"}' tx.log`" = "NOTHING" ]
    then
        echo "Test 2b FAILED:   Cannot locate tmax" | tee -a $results
	else
        echo "Test 2b PASSED:   $location" >> $results
    fi
fi

if [ "$test_gui" = "1" ]
then
    echo " Running  Test 3 - testing GUIs"
else
    echo " Skipping Test 3 - GUI"
fi
# GUI tests here
if [ "$test_gui" = "1" ]
then
    echo "     3a  running design_vision in GUI mode..."
	echo "        -> Please use the GUI to exit the tool"
	echo "           The test is successful if you see the GUI!"
    design_vision 
fi

# GUI tests here
if [ "$test_gui" = "1" ]
then
    echo "     3b  running tmax in GUI mode..."
	echo "        -> Please use the GUI to exit the tool"
	echo "           The test is successful if you see the GUI!"
    tmax -gui 
fi

/bin/rm -f 
# results reporting - if grep finds 'FAIL' it returns with 0, else 1
grep FAIL $results >& /dev/null
if [ "$?" = "0" ]
then
  echo "" >> $results
  echo "  *******************************************************" >> $results
  echo "  * Recommended Suggestions for Corrections of FAILURES *" >> $results
  echo "  *******************************************************" >> $results
  echo "" >> $results
  echo "  1. Be sure the class materials installed correctly.    " >> $results
  echo "" >> $results
  echo "  2. Be sure the required executables are in your path." >> $results
  echo "" >> $results
  echo "     Have a look at the tool log files in .Test/" >> $results
  echo ""
  echo " Installation Test FAILS for DFT Compiler 1 workshop" | tee -a $results
  echo " For details execute: cat .Test/results"
else
  echo ""
  echo " Installation Test PASSED for DFT Compiler 1 workshop" | tee -a $results
  echo ""
fi
