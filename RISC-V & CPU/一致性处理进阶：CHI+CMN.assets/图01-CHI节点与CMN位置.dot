digraph chi_cmn_overview {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.28",
    nodesep="0.55",
    ranksep="0.85",
    splines=line,
    outputorder=edgesfirst,
    fontname="Noto Sans CJK SC",
    fontsize=24,
    label="CHI协议节点与CMN中的位置",
    labelloc=t,
    labeljust=c
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#334155",
    fillcolor="#FFFFFF",
    fontname="Noto Sans CJK SC",
    fontsize=18,
    fontcolor="#0F172A",
    penwidth=1.8,
    margin="0.20,0.14"
  ];

  edge [
    color="#475569",
    fontname="Noto Sans CJK SC",
    fontsize=14,
    fontcolor="#334155",
    penwidth=1.8,
    arrowsize=0.8
  ];

  subgraph cluster_requesters {
    label="请求节点";
    color="#2563EB";
    fillcolor="#EFF6FF";
    style="rounded,filled";
    penwidth=2.0;
    fontname="Noto Sans CJK SC";
    fontsize=18;
    margin=18;

    rnf [label="RN-F\nCPU簇与硬件一致性Cache", fillcolor="#DBEAFE"];
    rni [label="RN-I或RN-D\nI/O一致性DMA或加速器", fillcolor="#DBEAFE"];
  }

  subgraph cluster_cmn {
    label="CoreLink CMN\n采用CHI的网格互连";
    color="#0F766E";
    fillcolor="#F0FDFA";
    style="rounded,filled";
    penwidth=2.0;
    fontname="Noto Sans CJK SC";
    fontsize=18;
    margin=20;

    xp [label="XP\n网格交换节点", fillcolor="#CCFBF1"];
    hnf [label="HN-F\nPoC、目录、可选SLC", fillcolor="#CCFBF1"];
    hni [label="HN-I\nI/O访问次序", fillcolor="#CCFBF1"];

    xp -> hnf [label="访问目标选择"];
    xp -> hni [label="I/O访问"];
  }

  subgraph cluster_subordinates {
    label="从属节点";
    color="#B45309";
    fillcolor="#FFFBEB";
    style="rounded,filled";
    penwidth=2.0;
    fontname="Noto Sans CJK SC";
    fontsize=18;
    margin=18;

    snf [label="SN-F\nDRAM控制器或普通内存", fillcolor="#FEF3C7"];
    sni [label="SN-I\nMMIO外设或普通内存", fillcolor="#FEF3C7"];
  }

  rnf -> xp [label="REQ；RSP/DAT/SNP", dir=both, color="#2563EB", fontcolor="#1D4ED8"];
  rni -> xp [label="REQ；RSP/DAT", dir=both, color="#2563EB", fontcolor="#1D4ED8"];
  hnf -> snf [label="REQ；RSP/DAT", dir=both, color="#B45309", fontcolor="#92400E"];
  hni -> sni [label="REQ；RSP/DAT", dir=both, color="#B45309", fontcolor="#92400E"];
}
