digraph AlkaidCoherenceTopology {
    graph [
        rankdir=TB,
        newrank=true,
        compound=true,
        ordering=out,
        bgcolor="#FFFFFF",
        pad="0.34",
        nodesep="0.70",
        ranksep="0.76",
        esep="+10",
        splines=ortho,
        fontname="Noto Sans CJK SC Bold",
        fontsize=48,
        labelloc=t,
        label="Alkaid双hart一致性扩展信号拓扑"
    ];

    node [
        shape=box,
        style="rounded,filled",
        color="#64748B",
        fillcolor="#F8FAFC",
        fontcolor="#0F172A",
        fontname="Noto Sans CJK SC Bold",
        fontsize=30,
        penwidth=2.5,
        margin="0.28,0.20"
    ];

    edge [
        color="#475569",
        fontcolor="#334155",
        fontname="Noto Sans CJK SC Bold",
        fontsize=22,
        penwidth=3.6,
        arrowsize=0.95,
        headclip=true,
        tailclip=true
    ];

    subgraph cluster_hart0 {
        label="hart0私有部分";
        color="#60A5FA";
        fillcolor="#EFF6FF";
        style="rounded,filled";
        penwidth=2.6;
        fontname="Noto Sans CJK SC Bold";
        fontsize=32;
        margin=28;

        c0_snoop [
            label="本地失效输入\nvalid + addr\n来源不是hart0",
            shape=ellipse,
            group="hart0_middle",
            width=3.70,
            height=1.42,
            fillcolor="#FFEDD5",
            color="#F97316"
        ];

        c0_l0 [
            label="LSU与\nLSU L0 Cache\n按组号和标签\n精确清除",
            width=2.90,
            height=2.00,
            group="c0_left_cache",
            fillcolor="#DBEAFE",
            color="#3B82F6"
        ];
        c0_dc [
            label="DCache（可选）\n写穿透\n清除目标组的\n全部路\n输出AXI4-Full\nAWATOP / ARATOP",
            width=3.35,
            height=2.55,
            group="hart0_middle",
            fillcolor="#DBEAFE",
            color="#3B82F6"
        ];
        c0_ic [
            label="ICache（只读）\nIMEM写触发\n全Cache失效",
            width=2.90,
            height=2.00,
            group="c0_right_cache",
            fillcolor="#DBEAFE",
            color="#3B82F6"
        ];

        c0_middle [
            shape=point,
            label="",
            group="hart0_middle",
            width=0.01,
            height=0.01,
            fixedsize=true,
            style=invis
        ];

        c0_left_top [
            shape=point, label="", group="c0_left_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];
        c0_left_bottom [
            shape=point, label="", group="c0_left_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];
        c0_right_top [
            shape=point, label="", group="c0_right_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];
        c0_right_bottom [
            shape=point, label="", group="c0_right_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];

        { rank=same; c0_left_top; c0_l0; c0_middle; c0_ic; c0_right_top; }
        c0_left_top -> c0_l0 [style=invis, weight=1000];
        c0_l0 -> c0_middle [style=invis, weight=1000];
        c0_middle -> c0_ic [style=invis, weight=1000];
        c0_ic -> c0_right_top [style=invis, weight=1000];
        c0_middle -> c0_dc [style=invis, weight=3000];
        c0_dc -> c0_snoop [style=invis, weight=500];
        { rank=same; c0_left_bottom; c0_snoop; c0_right_bottom; }
        c0_left_bottom -> c0_snoop [style=invis, weight=1000];
        c0_snoop -> c0_right_bottom [style=invis, weight=1000];

        c0_left_bottom -> c0_snoop:w [color="#F97316", dir=none, constraint=false];
        c0_left_top -> c0_left_bottom [color="#F97316", dir=none, constraint=false];
        c0_left_top -> c0_l0:w [color="#F97316", constraint=false];
        c0_snoop:n -> c0_dc:s [color="#F97316", constraint=false];
        c0_snoop:e -> c0_right_bottom [color="#F97316", dir=none, constraint=false];
        c0_right_top -> c0_right_bottom [color="#F97316", dir=none, constraint=false];
        c0_ic:e -> c0_right_top [color="#F97316", dir=back, arrowhead=none, arrowtail=normal, constraint=false];
    }

    subgraph cluster_hart1 {
        label="hart1私有部分";
        color="#4ADE80";
        fillcolor="#F0FDF4";
        style="rounded,filled";
        penwidth=2.6;
        fontname="Noto Sans CJK SC Bold";
        fontsize=32;
        margin=28;

        c1_snoop [
            label="本地失效输入\nvalid + addr\n来源不是hart1",
            shape=ellipse,
            group="hart1_middle",
            width=3.70,
            height=1.42,
            fillcolor="#FFEDD5",
            color="#F97316"
        ];

        c1_left_cache [
            label="ICache（只读）\nIMEM写触发\n全Cache失效",
            width=2.90,
            height=2.00,
            group="c1_left_cache",
            fillcolor="#DCFCE7",
            color="#22C55E"
        ];
        c1_dc [
            label="DCache（可选）\n写穿透\n清除目标组的\n全部路\n输出AXI4-Full\nAWATOP / ARATOP",
            width=3.35,
            height=2.55,
            group="hart1_middle",
            fillcolor="#DCFCE7",
            color="#22C55E"
        ];
        c1_right_cache [
            label="LSU与\nLSU L0 Cache\n按组号和标签\n精确清除",
            width=2.90,
            height=2.00,
            group="c1_right_cache",
            fillcolor="#DCFCE7",
            color="#22C55E"
        ];

        c1_middle [
            shape=point,
            label="",
            group="hart1_middle",
            width=0.01,
            height=0.01,
            fixedsize=true,
            style=invis
        ];

        c1_left_top [
            shape=point, label="", group="c1_left_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];
        c1_left_bottom [
            shape=point, label="", group="c1_left_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];
        c1_right_top [
            shape=point, label="", group="c1_right_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];
        c1_right_bottom [
            shape=point, label="", group="c1_right_route",
            width=0.01, height=0.01, fixedsize=true, style=invis
        ];

        { rank=same; c1_left_top; c1_left_cache; c1_middle; c1_right_cache; c1_right_top; }
        c1_left_top -> c1_left_cache [style=invis, weight=1000];
        c1_left_cache -> c1_middle [style=invis, weight=1000];
        c1_middle -> c1_right_cache [style=invis, weight=1000];
        c1_right_cache -> c1_right_top [style=invis, weight=1000];
        c1_middle -> c1_dc [style=invis, weight=3000];
        c1_dc -> c1_snoop [style=invis, weight=500];
        { rank=same; c1_left_bottom; c1_snoop; c1_right_bottom; }
        c1_left_bottom -> c1_snoop [style=invis, weight=1000];
        c1_snoop -> c1_right_bottom [style=invis, weight=1000];

        c1_left_bottom -> c1_snoop:w [color="#F97316", dir=none, constraint=false];
        c1_left_top -> c1_left_bottom [color="#F97316", dir=none, constraint=false];
        c1_left_top -> c1_left_cache:w [color="#F97316", constraint=false];
        c1_snoop:n -> c1_dc:s [color="#F97316", constraint=false];
        c1_snoop:e -> c1_right_bottom [color="#F97316", dir=none, constraint=false];
        c1_right_top -> c1_right_bottom [color="#F97316", dir=none, constraint=false];
        c1_right_cache:e -> c1_right_top [color="#F97316", dir=back, arrowhead=none, arrowtail=normal, constraint=false];
    }

    subgraph cluster_control {
        label="双hart共享控制";
        labeljust=l;
        color="#CBD5E1";
        fillcolor="#F8FAFC";
        style="rounded,filled";
        penwidth=2.6;
        fontname="Noto Sans CJK SC Bold";
        fontsize=32;
        margin=24;

        iarb [
            label="取指读仲裁\n共享ID分配\n响应准确回送",
            width=3.80,
            height=1.90,
            fillcolor="#F1F5F9",
            color="#64748B"
        ];

        cm [
            label="数据一致性控制\n轮换仲裁与共享ID分配\n读写冲突控制\nLR/SC与AMO\n消费AWATOP / ARATOP",
            width=4.80,
            height=2.65,
            group="data_center",
            fillcolor="#FEE2E2",
            color="#DC2626",
            penwidth=3.1
        ];

        snoop_router [
            label="监听失效分发\n共享侧AW握手产生\nVALID / OWNER / ADDR\n只通知另一个CPU",
            width=4.55,
            height=2.40,
            fillcolor="#FFEDD5",
            color="#F97316",
            penwidth=2.9
        ];

        iarb -> snoop_router [style=invis, weight=1000];
        snoop_router -> cm [style=invis, weight=1000];
        cm -> snoop_router [
            color="#F97316",
            penwidth=4.2,
            constraint=false
        ];
    }

    shared_cache [
        label="互连侧AXI4-Lite Cache\nSoC当前关闭\n标准AXI4-Full直通",
        width=4.85,
        height=1.85,
        group="data_center",
        fillcolor="#E0F2FE",
        color="#0284C7"
    ];

    route [
        label="写地址选择\n由AWADDR生成6位AWROUTE",
        width=4.85,
        height=1.65,
        group="data_center",
        fillcolor="#F3E8FF",
        color="#9333EA"
    ];

    pingpong [
        label="乒乓缓存\nAW与AWROUTE同时保存\n其余AXI4-Full通道独立缓存",
        width=4.85,
        height=1.95,
        group="data_center",
        fillcolor="#F3E8FF",
        color="#9333EA"
    ];

    xbar [
        label="Crossbar\n按地址选择从端\n以未完成事务计数保持W、B、R目标",
        width=5.45,
        height=2.00,
        group="data_center",
        fillcolor="#E0E7FF",
        color="#4F46E5",
        penwidth=2.9
    ];

    legend [
        shape=plain,
        group="hart0_outer",
        fontname="Noto Sans CJK SC Bold",
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="8" CELLPADDING="2">
                <TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="30"><B>图例</B></FONT></TD></TR>
                <TR><TD><FONT POINT-SIZE="28" COLOR="#DC2626">●</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="27"><B>CPU至数据一致性控制的</B><BR/><B>原子操作扩展</B></FONT></TD></TR>
                <TR><TD><FONT POINT-SIZE="28" COLOR="#F97316">●</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="27"><B>数据一致性控制发往另一个CPU的</B><BR/><B>监听失效接口</B></FONT></TD></TR>
                <TR><TD><FONT POINT-SIZE="28" COLOR="#0284C7">●</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="27"><B>数据一致性控制之后的</B><BR/><B>标准AXI4-Full</B></FONT></TD></TR>
                <TR><TD><FONT POINT-SIZE="28" COLOR="#9333EA">●</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="27"><B>Crossbar内部AWROUTE与</B><BR/><B>乒乓缓存</B></FONT></TD></TR>
            </TABLE>
        >
    ];

    legend_spacer [
        shape=box,
        label="",
        group="hart1_outer",
        width=8.00,
        height=1.00,
        fixedsize=true,
        style=invis
    ];

    subgraph cluster_shared {
        label="共享地址空间";
        labelloc=b;
        color="#CBD5E1";
        fillcolor="#F8FAFC";
        style="rounded,filled";
        penwidth=2.6;
        fontname="Noto Sans CJK SC Bold";
        fontsize=32;
        margin=22;

        imem [label="IMEM", width=1.65, height=0.82, fillcolor="#FFFFFF"];
        dmem [label="DMEM", width=1.65, height=0.82, fillcolor="#FFFFFF"];
        mmio [label="调试模块、APB\nCLINT、PLIC", width=3.40, height=1.12, fillcolor="#FFFFFF"];
        { rank=same; imem; dmem; mmio; }
    }

    c0_dc:e -> cm:w [color="#DC2626", penwidth=4.2, weight=0];
    c1_dc:w -> cm:e [color="#DC2626", penwidth=4.2, weight=0];
    c0_ic:e -> iarb:w [
        dir=both, arrowhead=normal, arrowtail=normal,
        color="#64748B", weight=0
    ];
    c1_left_cache:w -> iarb:e [
        dir=both, arrowhead=normal, arrowtail=normal,
        color="#64748B", weight=0
    ];

    snoop_router:w -> c0_snoop:e [color="#F97316", penwidth=4.0, constraint=false];
    snoop_router:e -> c1_snoop:w [color="#F97316", penwidth=4.0, constraint=false];

    cm -> shared_cache [
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        color="#0284C7",
        penwidth=4.2
    ];
    shared_cache -> route [color="#0284C7", penwidth=4.0];
    route -> pingpong [color="#9333EA", penwidth=4.0];
    pingpong -> xbar [
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        color="#4F46E5",
        penwidth=4.0
    ];
    iarb -> xbar [
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        color="#64748B",
        constraint=false
    ];

    xbar -> imem [
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        color="#4F46E5",
        minlen=2
    ];
    xbar -> dmem [
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        color="#4F46E5",
        minlen=2
    ];
    xbar -> mmio [
        dir=both,
        arrowhead=normal,
        arrowtail=normal,
        color="#4F46E5",
        minlen=2
    ];

    { rank=same; c0_left_top; c0_l0; c0_middle; c0_ic; c0_right_top; c1_left_top; c1_left_cache; c1_middle; c1_right_cache; c1_right_top; }
    c0_left_top -> c0_l0 [style=invis, weight=10000];
    c0_l0 -> c0_middle [style=invis, weight=10000];
    c0_middle -> c0_ic [style=invis, weight=10000];
    c0_ic -> c0_right_top [style=invis, weight=10000];
    c0_right_top -> c1_left_top [style=invis, weight=10000];
    c1_left_top -> c1_left_cache [style=invis, weight=10000];
    c1_left_cache -> c1_middle [style=invis, weight=10000];
    c1_middle -> c1_right_cache [style=invis, weight=10000];
    c1_right_cache -> c1_right_top [style=invis, weight=10000];

    { rank=same; c0_left_bottom; c0_snoop; c0_right_bottom; c1_left_bottom; c1_snoop; c1_right_bottom; }
    c0_left_bottom -> c0_snoop [style=invis, weight=10000];
    c0_snoop -> c0_right_bottom [style=invis, weight=10000];
    c0_right_bottom -> c1_left_bottom [style=invis, weight=10000];
    c1_left_bottom -> c1_snoop [style=invis, weight=10000];
    c1_snoop -> c1_right_bottom [style=invis, weight=10000];

    dmem -> legend [style=invis, weight=500];
    { rank=same; legend; legend_spacer; }
    legend_spacer -> legend [style=invis, weight=10000];
}
