# =============================================================================
# bms 默认 EMAN 模板
#
# 推荐放在与 vcs_com 同级的 regr/eman_template.emc（bms 会优先于此处查找）。
# regr/ 下还可放 vcs_error_patterns.eme 或 vcs_error_patterns.emc，生成 eman 命令时会
# 自动加 -error_pattern_file（也可用 BMS_EMAN_ERROR_PATTERN 指绝对路径）。
#
# eman -project 默认用当前登录用户名；覆盖请设 BMS_EMAN_PROJECT 或 EMAN_PROJECT。
# 其它环境变量（与 Verdi/ExecMan GUI 一致）：
#   BMS_EMAN_CONFIG                   -> -config（不设则自动为 test_lib 父目录名，如 .../it/test_lib -> it）
#   BMS_EMAN_DEBUG_DIR                -> debug 根（不设则为 test_lib/debug）；可写 /tmpdata/zc_data/{user}/debug
#                                       （{user}、%u = 当前登录名，与路径里个人目录一致）
#   BMS_EMAN_RUNDIR_EXPR              -> 若设置则 build/sim 共用该表达式；不设则 per-case …/$$EMAN_SESSION_NAME/<tc>
#   BMS_EMAN_NO_AUTO_CLEANUP=1        -> 不加 -auto_cleanup；或设 BMS_EMAN_AUTO_CLEANUP=0
#   BMS_EMAN_OVERWRITE=1              -> -overwrite
#   BMS_EMAN_EXTRA                    -> 额外参数（shlex 分词拼到命令末尾）
#   BMS_EMAN_BUILD_NODES / BMS_EMAN_BUILD_TIMEOUT -> 生成 build 条目的 nodes / timeout（默认 1 / 86400）
#   BMS_EMAN_DEBUG_RERUN_COUNT        -> 仅 bms -eman -debug 时写入 tests: options.debug_rerun_count（默认 2；0=关闭）
#   bms -eman -debug                 -> 生成 .emc 时写入 debug_rerun_count + 每 test 的 debug_run_cmd，且 eman 加 -debug
#   BMS_EMAN_REGR_DEBUG=1 / BMS_EMAN_REGR_DEBUG_FLAGS -> 可选，无 -debug 时也可让 eman 带 -debug 等
#   BMS_EMAN_TEMPLATE                 -> 指定 emc 模板绝对路径
#
# 以下占位行由 bms 展开为 env: + variables(fsdb_opt/cov_opt) + modes(fsdb/cov)，供 Web 里手动 rerun 时选 dump / 覆盖率
#
# - -eman：server EMAN，编译由 EMAN build 调度；build/tests 下各一行占位符（见文末），勿写在注释里。
# =============================================================================

__BMS_EMC_TOP__
builds:
__BMS_EMC_BUILDS__

tests:
__BMS_EMC_TESTS__
