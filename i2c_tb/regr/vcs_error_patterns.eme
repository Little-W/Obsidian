# Error pattern ::: base status ::: custom status ::: priority
######## VCS ERROR PATTERNS ###########
^Error-\[.*:::fail:::vcs_error:::0
^Dumping VCS Annotated Stack: :::fail:::vcs_stack_trace_fail:::0
^.*: started at \d+\w?s failed at \d+\w?s:::fail:::vcs_assertion_error:::0
^Time: \d+:::pass:::pass:::15

######## UVM ERROR PATTERNS ###########
^UVM_FATAL :\s*[1-9]+:::fail:::uvm_fatal:::0
^UVM_ERROR :\s*[1-9]+:::fail:::uvm_error:::0
#^UVM_WARNING :\s*[1-9]+:::warn:::uvm_warn:::1
^UVM_INFO :\s*[1-9]+:::pass:::uvm_info:::2

^Offending :::fail:::assert_fatal:::0
^\-\-\- UVM Report catcher Summary \-\-\-:::pass:::pass:::13

####### OVM ERROR PATTERNS ############
^OVM_FATAL :\s*[1-9]+:::fail:::ovm_fatal:::0
^OVM_ERROR :\s*[1-9]+:::fail:::ovm_error:::0
^OVM_WARNING :\s*[1-9]+:::warn:::ovm_warn:::1
^OVM_INFO :\s*[1-9]+:::pass:::ovm_info:::2

###### ADDITIONAL PATTERNS #########
^merge failed:::fail:::merge_failed:::5
^collect failed:::fail:::collect_failed:::6
^merge successful:::pass:::merge_passed:::10
^collect successful:::pass:::collect_passed:::16

### COMPILE PATTERNS ###

^.*simv.* up to date:::pass:::build_passed:::5
^--- Stack trace follows:::fail:::vcs_crash:::0
simv not found:::fail:::simv_not_found:::0
^An unexpected termination:::fail:::vcs_crash:::0

##### UNR PATTERNS #####
^\[Info\] COV_EXCLUSION_FILE_SAVED:::pass:::pass:::4
^Warning: Coverage exclusion file cannot be saved:::warn:::exclusions_not_saved:::3

##### VHDL ASSERTION AND VERILOG PATTERNS #####
^Assertion ERROR at \d+:::fail:::error:::0
^Assertion FAILURE at \d+:::fail:::failure:::0
^Fatal: \".*at time \d+:::fail:::fatal:::0
^Error: \".*at time \d+:::fail:::error:::0
^Report FAILURE at \d+:::fail:::failure:::1
^Report ERROR at \d+:::fail:::failure:::1
^Error: uninitialized virtual interface object:::fail:::error:::1

#### ICO PATTERNS ####
^Error-\[CNST\-SB.*\].*:::fail:::ico_error:::0
