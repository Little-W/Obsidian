[VLOGAN]
-full64
-sverilog
-timescale=1ns/1ps
-ntb_opts uvm-1.2
+define+UVM_NO_DEPRECATED
+define+UVM_PACKER_MAX_BYTES=200000
+define+BMS_USE_SVT_VIP
+define+SVT_I2C_MAX_NUM_MASTERS_1
+define+SVT_I2C_MAX_NUM_SLAVES_1

-kdb
+vcs+lic+wait -notice +nospecify +notimingcheck
-CFLAGS "-std=c99" -DVCS -pcmakeprof -debug_acc+all+dmptf+pp -debug_region+cell+encrypt
-l vlogan.log

+incdir+$ZC_NPU_VERIF_ROOT/2_verf/it/i2c_tb/tb
+incdir+$ZC_NPU_VERIF_ROOT/2_verf/it/i2c_tb/seq_lib
+incdir+$ZC_NPU_VERIF_ROOT/2_verf/it/i2c_tb/seq_lib/common
+incdir+$ZC_NPU_VERIF_ROOT/2_verf/it/i2c_tb/seq_lib/i2c_seq
+incdir+$ZC_NPU_VERIF_ROOT/2_verf/it/i2c_tb/env
+incdir+$ZC_NPU_VERIF_ROOT/2_verf/it/i2c_tb/env/agent
+incdir+$ZC_NPU_VERIF_ROOT/2_verf/it/i2c_tb/env/vip

[VCS_RTL_ELAB]
-full64
-lca
-debug_access+all
-top MCU_I2C_WRAPPER
-Mupdate
-pcmakeprof
-partcomp
-fastpartcomp=j4
-l vcs_elb.log
-CFLAGS -DVCS +plusarg_save

[VCS_TEST_ELAB]
-full64
-lca
-debug_access+all
-top i2c_tb
-Mupdate
-pcmakeprof
-partcomp ${VCS_HOME}/etc/uvm-1.2/dpi/uvm_dpi.cc
-fastpartcomp=j4
-l vcs_elb.log
-CFLAGS -DVCS +plusarg_save
